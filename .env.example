# Configuration LLM (API Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=60


# Embedding
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# Vector DB
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=eih_scolarite

# RAG Hyperparameters
RETRIEVAL_TOP_K=5
# Seuil de refus (score cosinus du meilleur fragment), calibré le 30/10/2026 :
# hors corpus <= 0.81, dans le corpus >= 0.86. Recalibrer : uv run python eval/calibrate_threshold.py
SCORE_THRESHOLD=0.83

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:4200

# les chunks
CHUNK_STRATEGY=structural
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_SECTION_CHARS=900

